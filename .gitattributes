# CACH-03: enforce LF for text files repo-wide so Windows checkouts don't
# rewrite files to CRLF — that would flip cache-prefix bytes per-host.
* text=auto eol=lf

# PLAT-05: explicit per-extension rules for cross-platform line endings.
# Source code — always LF, regardless of platform
*.ts text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Windows-specific scripts — preserve CRLF (cmd / batch / PowerShell expect it)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# INST-01: explicit install-wrapper rules — redundant with the *.sh / *.bat
# rules above but documented here so first-time readers understand why
# install.sh stays LF (POSIX shebang) and install.bat stays CRLF (cmd parser).
install.sh text eol=lf
install.bat text eol=crlf

# Binary types — preserved as-is.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.db binary
*.sqlite binary
